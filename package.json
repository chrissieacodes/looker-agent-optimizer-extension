{
  "name": "agent-optimizer-extension",
  "version": "1.0.0",
  "description": "Looker Extension Framework application for optimizing AI agents and feedback telemetry.",
  "main": "dist/bundle.js",
  "scripts": {
    "build": "webpack --mode production --config webpack.config.js",
    "develop": "webpack serve --mode development --hot --port 8080 --config webpack.config.js",
    "start": "node server.js",
    "deploy": "gcloud run deploy agent-optimizer-extension --source . --project cloud-looker-devrel-demos --region us-central1 --no-allow-unauthenticated",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@looker/components": "5.0.3",
    "@looker/components-providers": "1.5.34",
    "@looker/design-tokens": "3.1.1",
    "@looker/extension-sdk": "^26.12.0",
    "@looker/extension-sdk-react": "^26.12.0",
    "@looker/icons": "1.5.21",
    "@looker/sdk": "^26.12.0",
    "@looker/sdk-rtl": "^21.6.4",
    "express": "^5.2.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^5.3.4",
    "styled-components": "5.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^3.3.4",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  },
  "resolutions": {
    "styled-components": "5.3.1"
  }
}
